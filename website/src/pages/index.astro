---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Why from '../components/Why.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import LocalBand from '../components/LocalBand.astro';
import OpenSource from '../components/OpenSource.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Footer from '../components/Footer.astro';

const title = 'Silta: a local context hub and backlog for coding agents';
const description =
	'Silta gives Claude Code, Codex and you one local place for tasks, plans, handoffs and the map of your apps. One command starts every agent session with the whole picture. Free, open source, runs on your Mac.';
---

<MarketingLayout title={title} description={description}>
	<Nav slot="header" />
	<Hero />
	<TrustBar />
	<Why />
	<HowItWorks />
	<Features />
	<LocalBand />
	<OpenSource />
	<ClosingCTA />
	<Footer slot="footer" />
</MarketingLayout>
