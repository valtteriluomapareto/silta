---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/site.css';
import { withBase } from '../utils';
import { GITHUB_URL } from '../consts';

interface Props {
	title: string;
	description: string;
	/** For pages that must stay out of search results, such as the 404 page. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// OpenGraph and canonical URLs must be absolute; social scrapers reject
// relative image paths.
const absolute = (path: string) =>
	Astro.site ? new URL(withBase(path), Astro.site).toString() : withBase(path);

const canonicalUrl = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: Astro.url.toString();
const ogImageUrl = absolute('board-light.png');
const ogImageAlt =
	'Silta Dev showing the Acme board, with tasks claimed by Claude and Codex';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Silta',
	description,
	operatingSystem: 'macOS 26 or later',
	applicationCategory: 'DeveloperApplication',
	license: 'https://opensource.org/license/mit',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	codeRepository: GITHUB_URL,
	url: canonicalUrl,
	image: ogImageUrl,
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<link rel="canonical" href={canonicalUrl} />
		)}
		<link
			rel="icon"
			href={withBase('silta-mark-light.svg')}
			type="image/svg+xml"
		/>
		<link rel="sitemap" href={withBase('sitemap-index.xml')} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Silta" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1600" />
		<meta property="og:image:height" content="956" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">
			Skip to content
		</a>
		<slot name="header" />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<slot name="footer" />
	</body>
</html>
