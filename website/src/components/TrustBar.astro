---
// Four short facts under the hero. Icons are decorative.
const items = [
	{
		label: 'Runs on your Mac',
		icon: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4" stroke-linecap="round"/>',
	},
	{
		label: 'No server, no account',
		icon: '<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8" stroke-linecap="round"/>',
	},
	{
		label: 'Claude Code and Codex',
		icon: '<path d="M4 17l6-6-6-6M12 19h8" stroke-linecap="round" stroke-linejoin="round"/>',
	},
	{
		label: 'Open source, MIT',
		icon: '<path d="M8 6l-6 6 6 6M16 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>',
	},
];
---

<section class="trust" aria-label="At a glance">
	<ul>
		{items.map((item) => (
			<li>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="var(--color-accent)"
					stroke-width="2"
					aria-hidden="true"
					set:html={item.icon}
				/>
				{item.label}
			</li>
		))}
	</ul>
</section>

<style>
	.trust {
		border-block: 1px solid var(--color-separator);
		background: var(--color-bg-grouped);
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 22px;
		max-width: 1440px;
		margin-inline: auto;
		padding: 18px var(--page-gutter);
	}
	li {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: var(--text-mono);
		font-weight: 600;
		line-height: 18px;
	}
	svg {
		flex-shrink: 0;
	}

	@media (min-width: 768px) {
		ul {
			justify-content: center;
			gap: 12px 56px;
			padding-block: 20px;
		}
	}
</style>
